# ── 개발 서버 프록시 대상 (vite.config.js) ────────────────────────────────
# VITE_ 접두사가 없으므로 브라우저 번들에는 들어가지 않습니다(dev 서버 전용).
# 로컬 개발 시 연결할 백엔드 주소를 .env.local에 입력해 사용합니다.
#
# 1. 메인 백엔드 서버 (인증, 도서 CRUD, 서재, OCR 등)
MAIN_BACKEND_URL=http://127.0.0.1:8000

# 2. AI / 도서 추천 에이전트 백엔드 서버 (사서 채팅, AI 추천 등)
AI_BACKEND_URL=http://127.0.0.1:8001

# ── 프로덕션 배포 빌드용 (Cloudflare Pages 등 정적 호스팅) ──────────────────
# 백엔드가 core-api / ai-agent 두 곳으로 나뉘어 있어 각각 절대 URL을 채워야 합니다.
# 비워두면 프론트와 같은 오리진의 /api/v1을 호출합니다(로컬 dev 프록시 또는 두
# 백엔드를 같은 도메인 뒤에 리버스 프록시로 합쳐 배포하는 경우와 호환).
#
# 1. backend-core-api (인증, 유저, 도서/서재 CRUD)
VITE_CORE_API_BASE_URL=https://backend-core-api.onrender.com/api/v1
# 2. backend-ai-agent (사서 채팅, 장르 분류, 월간 리포트, OCR)
VITE_AI_API_BASE_URL=https://backend-ai-agent-77ik.onrender.com/api/v1

# ── 개발용 인증 우회 (임시) ────────────────────────────────────────────────
# 인증 백엔드 없이 화면을 확인하기 위한 스위치입니다.
#   true  : 항상 우회 (로그인 버튼을 누르면 입력값과 무관하게 서재로 진입)
#   false : 항상 실제 로그인 API 호출 (인증 연동 검증 시)
#   미설정: `npm run dev`에서만 우회, 프로덕션 빌드는 실제 로그인
# 인증 연동이 끝나면 이 항목과 app/store/authBypass.js를 함께 제거합니다.
VITE_AUTH_BYPASS=
# ── 소셜 로그인 (OAuth) ───────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_JAVASCRIPT_KEY=
